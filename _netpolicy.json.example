{
  "_用法": "复制本文件为 _netpolicy.json 后按本机情况改。热配置：改完下一跳即生效，不用重启。真实配置 _netpolicy.json 从未入库（含域名/端口/机器参数），换机靠本模板重建。",
  "_出网": "默认走 fleet/net.py 真直连层。prefer=direct 直连优先；proxy 留空=纯直连。proxies 支持多出口，同域 hash 固定粘一个。",
  "prefer": "direct",
  "proxy": "",
  "proxies": [],
  "_白名单分流": "命中 proxy_domains 的域走 proxy_domains_proxy，且该代理探活失败自动回落直连（不留死配置）。不需要就留空数组。不要在这里写自己的本地端口。",
  "proxy_domains": [],
  "proxy_domains_proxy": "",
  "_国内分流": "按解析出的 IP 归属判国内外（cn_ranges.py），不是域名后缀。",
  "cn_direct": true,
  "_加速口": "国外目标的旧 HTTP 加速代理，留空=不启用，改走 foreign_tunnel。",
  "accelerate_proxy": "",
  "_隧道": "国外直连不通时的回落：Cloudflare Worker 隧道，selfproxy 进程内建连、不新开端口。密钥只读 ~/.fleet/wsrelay.key，代码零默认值。留空=关闭隧道一键回滚。换域只改 foreign_tunnel 一处即热生效。",
  "foreign_tunnel": "",
  "tunnel_connect_timeout": 25.0,
  "_爬虫出口": "爬虫默认接统一出口（如 http://127.0.0.1:18080）；留空=纯直连。NETFORCE_PROXY 环境变量优先。",
  "crawler_proxy": "",
  "foreign_prefer": "direct",
  "use_fleet": true,
  "self_kernel": false,
  "use_direct_matrix": true,
  "timeout": 8.0,
  "browser_timeout": 15.0,
  "probe_ttl": 30.0,
  "probe_timeout": 0.35,
  "_并发": "conservative=与主爬虫和平共处；aggressive=整机拉满。按本机核数/内存调。",
  "gpu_angle": "vulkan",
  "concurrency": {
    "auto_threshold": 3000,
    "conservative": { "workers": 2, "tabs": 3, "gpu": false },
    "aggressive": { "workers": 3, "tabs": 5, "gpu": true }
  },
  "_深挖": "每个域抓完首页后按内容价值再挖 N 个站内文章页，0=只抓首页。",
  "deep_per_site": 8,
  "_任务层": "错峰并发/失败重试/Range 分片断点续传/出口掉线自愈。retry_max=0 关重试；全部热生效。",
  "task_layer": {
    "peak_cap": 20,
    "offpeak_cap": 40,
    "retry_max": 3,
    "range_chunk_mb": 4,
    "autoheal_egress": true,
    "external_budget": 0.18,
    "external_epsilon": 0.18
  }
}
